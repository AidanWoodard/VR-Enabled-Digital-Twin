<launch>
  <arg name="video_dev1" default="/dev/v4l/by-path/platform-vhci_hcd.0-usb-0:2:1.0-video-index0" />
  <arg name="video_dev2" default="/dev/v4l/by-path/platform-vhci_hcd.0-usb-0:3:1.0-video-index0" />
  <arg name="pixel_form1" default="mjpeg" />
  <arg name="pixel_form2" default="mjpeg" />

  <group ns="cam1">
    <!-- Run the node in background, then re-apply exposure_dynamic_framerate=0 after it
         has opened the device (usb_cam_node resets the control to 1 on open). -->
    <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen"
          launch-prefix="bash -c '$0 $@ &amp; BGPID=$!; sleep 3; v4l2-ctl -d $(arg video_dev1) -c exposure_dynamic_framerate=0 2>/dev/null; wait $BGPID'" >
      <param name="video_device" value="$(arg video_dev1)" />
      <param name="image_width" value="640" />
      <param name="image_height" value="480" />
      <param name="pixel_format" value="$(arg pixel_form1)" />
      <param name="framerate" value="30" />
      <param name="camera_frame_id" value="usb_cam" />
      <param name="io_method" value="mmap"/>
    </node>
    <node name="image_republisher" pkg="image_transport" type="republish"
          args="raw in:=usb_cam/image_raw compressed out:=usb_cam/image">
      <param name="compressed/jpeg_quality" value="80" />
    </node>
  </group>

  <group ns="cam2">
    <!-- Wait for cam1's by-path symlink to confirm it is kernel-ready, then force
         cam2's V4L2 stream parameters before usb_cam_node opens the device.
         This prevents the driver from inheriting a stale negotiated framerate
         left behind by a prior process, which causes ~15 fps instead of 30. -->
    <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen"
          launch-prefix="bash -c 'until [ -e $(arg video_dev1) ]; do sleep 0.2; done; sleep 2; $0 $@ &amp; BGPID=$!; sleep 3; v4l2-ctl -d $(arg video_dev2) -c exposure_dynamic_framerate=0 2>/dev/null; wait $BGPID'" >
      <param name="video_device" value="$(arg video_dev2)" />
      <param name="image_width" value="640" />
      <param name="image_height" value="480" />
      <param name="pixel_format" value="$(arg pixel_form2)" />
      <param name="framerate" value="30" />
      <param name="camera_frame_id" value="usb_cam2" />
      <param name="io_method" value="mmap"/>
    </node>
    <node name="image_republisher" pkg="image_transport" type="republish"
          args="raw in:=usb_cam/image_raw compressed out:=usb_cam/image">
      <param name="compressed/jpeg_quality" value="80" />
    </node>
  </group>

  <!-- <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    <remap from="image" to="/usb_cam/image_raw" />
    <param name="autosize" value="true" />
  </node> -->

</launch>
